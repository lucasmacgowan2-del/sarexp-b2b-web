# ==========================================================================
# SAREXP B2B WEBSITE - HOSTINGER APACHE DEPLOYMENT RULES (.htaccess)
# ==========================================================================

# 1. Enable compression to speed up load times
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript
</IfModule>

# 2. Caching rules: prevent stale cache on HTML/CSS/JS during updates
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|css|js)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>
</IfModule>

# 4. Cabeceras de seguridad (28/08/2026)
#
# El sitio no mandaba NINGUNA: ni HSTS, ni nosniff, ni X-Frame-Options, ni
# Referrer-Policy (comprobado con `curl -I https://sarexp.com/`). El ERP y el
# portal del grupo las tienen desde el 27/08.
#
# Que mod_headers funciona en este hosting esta comprobado, no asumido: las
# cabeceras de cache del bloque 2 de arriba SI llegan al navegador.
#
# NO hay Content-Security-Policy a proposito: una CSP mal puesta rompe el sitio
# de formas que solo se ven en un navegador (GA4, fuentes, el formulario de
# leads), y esa verificacion necesita ojos humanos.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# 5. Nada que no sea el sitio se sirve (28/08/2026)
#
# ACA LA CARPETA DEL REPO ES LA RAIZ DEL SITIO. El 28/08 se comprobo que estaban
# publicos, sin login y con codigo 200:
#
#   /deploy_sarexp_lead_workflow.py  -> CON EL TOKEN DE LA API DE n8n ADENTRO
#   /BUSINESS_STRATEGY.md            -> la estrategia comercial
#   /PROJECT_HANDOVER.md             -> como esta armado todo
#   /sarexp-b2b-web-build.zip        -> el sitio empaquetado
#   /CLAUDE.md                       -> notas internas
#
# Los archivos ya se sacaron del repo, pero esto es la red de seguridad: el dia
# que alguien vuelva a dejar un .md o un script en la raiz, no se sirve.
<FilesMatch "\.(md|py|sh|ps1|zip|tar|gz|bak|sql|env|log|json|yml|yaml)$">
    Require all denied
</FilesMatch>

# Los dotfiles tampoco (.git, .env, .htaccess mismo)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3. Prevent Directory Listing for security
Options -Indexes
